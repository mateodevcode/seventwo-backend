{
  "name": "seventwo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node src/index.js",
    "migrate": "node --env-file-if-exists=.env src/database/migrate.js",
    "test": "node --import ./test/env.js --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:db": "docker exec seventwo-postgres-dev psql -U seventwo -d seventwo -c \"CREATE DATABASE seventwo_test\"",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1"
  }
}
