# ─────────────────────────────────────────────────────────────
# seventwo-backend — variables de entorno
# Local:      cp .env.example .env  (valores de la sección LOCAL)
# Producción: /srv/infra/seventwo/seventwo-backend/.env en el VPS
#             (valores de la sección PRODUCCIÓN; ver docs/DEPLOY.md del frontend)
# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Evita el carácter $ en los valores (docker compose lo interpreta); si lo
# necesitas, escríbelo como $$.
# ─────────────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────────────
PORT=4000
# PRODUCCIÓN: production (el docker-compose ya lo fuerza)
NODE_ENV=development

# ── Base de datos ────────────────────────────────────────────
# Dos formas (si están las dos, gana DATABASE_URL):
#   a) DATABASE_URL=postgres://usuario:contraseña@host:puerto/base
#   b) DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME (como inmobitwo;
#      la contraseña no necesita codificarse para URL)
# LOCAL (npm run db:up):
DATABASE_URL=postgres://seventwo:seventwo_dev@localhost:5442/seventwo
# PRODUCCIÓN (postgres_central por la red interna central_network → puerto 5432,
# no el 5435 expuesto al exterior; el workflow crea la BD si no existe):
# DB_HOST=postgres_central
# DB_PORT=5432
# DB_USER=adminst
# DB_PASSWORD=CHANGE_ME
# DB_NAME=seventwo

# ── Frontend / cookies ───────────────────────────────────────
# Orígenes permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:3000
# PRODUCCIÓN: FRONTEND_URL=https://seventwo.tech,https://www.seventwo.tech
# Dominio de la cookie de sesión. Vacío en local; PRODUCCIÓN: .seventwo.tech
COOKIE_DOMAIN=

# ── Secretos (distintos entre sí, 64+ caracteres) ────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
AUTH_PEPPER=

# ── Email (Nodemailer + SMTP Brevo) ──────────────────────────
# Sin SMTP en local los emails se imprimen en consola. Obligatorio en producción.
BREVO_SMTP_EMAIL=
BREVO_SMTP_PASS=
BREVO_EMAIL_NO_REPLY=no-reply@seventwo.tech

# ── Solicitudes de presupuesto y notificaciones (docs/PRESUPUESTOS.md) ──
# Cada canal se activa solo si sus variables tienen valor; vacías = desactivado.
# Buzón del equipo: recibe el email de cada solicitud nueva y de cada respuesta del cliente.
EQUIPO_EMAIL=info@seventwo.tech
# socket-core (tiempo real). En el VPS, por la red interna (sin pasar por nginx):
#   SOCKET_CORE_URL=http://socket-core:3005
# La API key se obtiene una vez con scripts/alta_cliente.py en socket-core.
SOCKET_CORE_URL=
SOCKET_CORE_API_KEY=
SOCKET_CORE_CANAL=seventwo:notificaciones
# Web Push (PWA). Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@seventwo.tech
# Telegram: bot de @BotFather añadido al grupo del equipo; CHAT_ID del grupo (negativo).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# PRODUCCIÓN: GOOGLE_REDIRECT_URI=https://api.seventwo.tech/auth/google/callback
