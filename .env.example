# ── Servidor ─────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Base de datos ────────────────────────────────────
# Local (docker-compose.dev.yml):
DATABASE_URL=postgres://seventwo:seventwo_dev@localhost:5442/seventwo
# Producción (red interna del VPS), p. ej.:
# DATABASE_URL=postgres://seventwo:***@postgres_central:5432/seventwo

# ── Frontend / cookies ───────────────────────────────
# Orígenes permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:3000
# En producción: .seventwo.tech  (vacío en local = cookie del host actual)
COOKIE_DOMAIN=

# ── Secretos (genera cada uno con:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_REFRESH_SECRET=
AUTH_PEPPER=

# ── Email (Nodemailer + SMTP Brevo) ──────────────────
BREVO_SMTP_EMAIL=
BREVO_SMTP_PASS=
BREVO_EMAIL_NO_REPLY=no-reply@seventwo.tech

# ── Google OAuth ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
